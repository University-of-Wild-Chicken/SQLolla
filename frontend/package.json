{
  "name": "sqlolla-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Accessible local review workspace for SQLolla solver evidence.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsc --noEmit && vite build && node e2e/verify.mjs",
    "test:host": "node e2e/host.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:functions": "node scripts/check-function-length.mjs",
    "check": "prettier --check . && tsc --noEmit && vitest run && vite build && node scripts/check-function-length.mjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@viz-js/viz": "3.31.0",
    "lossless-json": "4.3.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.14.0",
    "jsdom": "26.1.0",
    "playwright-core": "1.65.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
