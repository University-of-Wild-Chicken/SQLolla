<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <httpErrors existingResponse="PassThrough" />
    <caching enabled="false" enableKernelCache="false" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="2097152" />
        <verbs allowUnlisted="false">
          <add verb="GET" allowed="true" />
          <add verb="HEAD" allowed="true" />
          <add verb="POST" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <clear />
        <rule name="SQLolla canonical authority" stopProcessing="true">
          <match url=".*" />
          <conditions><add input="{HTTP_HOST}" pattern="^sqlolla\.us$" negate="true" /></conditions>
          <action type="CustomResponse" statusCode="400" statusReason="Unexpected host" statusDescription="Use the configured SQLolla origin" />
        </rule>
        <rule name="SQLolla private loopback host" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8787/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
